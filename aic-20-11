<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Photobook Tri Ân Thầy Cô - AIC THPT Đầm Hà</title>
    <!-- Tải Tailwind CSS để tối ưu giao diện Responsive đẹp mắt -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font chữ Inter & Font viết tay mềm mại cho chủ đề 20/11 -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Patrick+Hand&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
        }
        .font-handwriting {
            font-family: 'Patrick Hand', cursive;
        }
        /* Hiệu ứng chớp đèn Flash khi chụp ảnh */
        @keyframes flashAnim {
            0% { opacity: 0.95; }
            100% { opacity: 0; }
        }
        .flash-effect {
            animation: flashAnim 0.45s ease-out forwards;
        }
        /* Hiệu ứng nảy số đếm ngược */
        @keyframes pulseScale {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.25); }
        }
        .countdown-pulse {
            animation: pulseScale 0.8s infinite;
        }
        /* Hiệu ứng mở App toàn màn hình chuẩn iOS/Android */
        .app-modal {
            transform-origin: center center;
            transition: transform 0.32s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.25s ease;
            will-change: transform, opacity;
        }
        .app-modal-closed {
            opacity: 0;
            transform: scale(0.88) translateY(24px);
            pointer-events: none;
            display: none !important;
        }
        .app-modal-open {
            opacity: 1;
            transform: scale(1) translateY(0);
            pointer-events: auto;
            display: flex !important;
        }
    </style>
</head>
<body class="bg-gradient-to-br from-rose-50 via-amber-50 to-orange-50 text-slate-800 min-h-screen flex flex-col">

    <!-- ===================================================================== -->
    <!-- PHẦN 1: MÀN HÌNH CHÀO MỪNG (INTRO / OVERVIEW PAGE)                    -->
    <!-- ===================================================================== -->
    <section id="intro-section" class="flex-1 flex flex-col justify-between transition-opacity duration-500">
        <!-- Thanh Header thương hiệu -->
        <header class="w-full max-w-6xl mx-auto px-4 sm:px-6 py-5 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-emerald-600 via-teal-800 to-slate-900 flex items-center justify-center text-white font-extrabold text-xs shadow-md shadow-emerald-500/20 overflow-hidden border border-emerald-500/40 shrink-0">
                    <img src="https://images.unsplash.com/photo-1518770660439-4636190af475?q=80&w=300&auto=format&fit=crop" alt="AIC Circuit Logo" class="w-full h-full object-cover">
                </div>
                <div>
                    <span class="font-extrabold text-sm sm:text-base tracking-tight text-slate-900 block leading-tight">AIC - Câu lạc bộ AI Trường Trung học Phổ thông Đầm Hà</span>
                    <span class="text-xs font-semibold text-rose-600">Products by Luu Trong with AIC</span>
                </div>
            </div>
            <span class="hidden sm:inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-bold bg-white/85 backdrop-blur text-emerald-700 border border-emerald-200 shadow-sm">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                100% Xử lý Local - Bảo mật tuyệt đối
            </span>
        </header>

        <!-- Nội dung chính (Hero Section) -->
        <main class="w-full max-w-6xl mx-auto px-4 sm:px-6 py-8 md:py-12 flex flex-col lg:flex-row items-center gap-10">
            <!-- Cột trái: Lời chào mừng & Nút hành động -->
            <div class="flex-1 text-center lg:text-left space-y-6">
                <div class="inline-block px-4 py-1.5 rounded-full bg-gradient-to-r from-rose-100 to-amber-100 text-rose-700 font-bold text-sm shadow-sm border border-rose-200/50">
                    ✨ Tri ân Thầy Cô Ngày Nhà Giáo Việt Nam 20/11 ✨
                </div>
                <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 leading-tight">
                    Lưu giữ khoảnh khắc <br>
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 via-rose-500 to-amber-500">
                        Tri ân các thầy cô giáo
                    </span>
                </h1>
                <p class="text-base sm:text-lg text-slate-600 max-w-xl mx-auto lg:mx-0 leading-relaxed">
                    Không gian <strong>Photobook Online</strong> chính thức của Câu lạc bộ AI THPT Đầm Hà. Chụp ảnh trực tiếp, áp dụng bộ lọc màu nghệ thuật và dán sticker dễ thương tặng các thầy cô nhân dịp 20/11!
                </p>

                <!-- Nút chuyển sang giao diện Photobook -->
                <div class="pt-2 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
                    <button onclick="enterStudio()" class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-gradient-to-r from-indigo-600 via-rose-500 to-amber-500 hover:opacity-95 text-white font-bold text-lg shadow-xl shadow-rose-500/25 transform hover:-translate-y-0.5 active:scale-95 transition-all flex items-center justify-center gap-2.5 cursor-pointer">
                        <span>📸</span>
                        <span>Mở App Chụp Photobook</span>
                    </button>
                </div>

                <!-- Các thẻ tính năng nổi bật -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-6">
                    <div class="bg-white/90 backdrop-blur p-3.5 rounded-2xl border border-rose-100 shadow-sm text-center">
                        <div class="text-2xl mb-1">🎨</div>
                        <h3 class="font-bold text-sm text-slate-800">Bộ màu Vintage</h3>
                        <p class="text-xs text-slate-500 mt-0.5">Natural, Nắng ấm, Retro</p>
                    </div>
                    <div class="bg-white/90 backdrop-blur p-3.5 rounded-2xl border border-rose-100 shadow-sm text-center">
                        <div class="text-2xl mb-1">⏱️</div>
                        <h3 class="font-bold text-sm text-slate-800">Hẹn giờ chụp</h3>
                        <p class="text-xs text-slate-500 mt-0.5">Tự động đếm ngược 3s/5s</p>
                    </div>
                    <div class="bg-white/90 backdrop-blur p-3.5 rounded-2xl border border-rose-100 shadow-sm text-center">
                        <div class="text-2xl mb-1">🌻</div>
                        <h3 class="font-bold text-sm text-slate-800">Sticker 20/11</h3>
                        <p class="text-xs text-slate-500 mt-0.5">Kho nhãn dán dễ thương</p>
                    </div>
                    <div class="bg-white/90 backdrop-blur p-3.5 rounded-2xl border border-rose-100 shadow-sm text-center">
                        <div class="text-2xl mb-1">🔒</div>
                        <h3 class="font-bold text-sm text-slate-800">Riêng tư 100%</h3>
                        <p class="text-xs text-slate-500 mt-0.5">Xử lý tại máy an toàn</p>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Thẻ minh họa trực quan khung Photobook -->
            <div class="w-full max-w-md lg:w-5/12">
                <div class="relative bg-white/95 backdrop-blur p-4 pb-8 rounded-3xl shadow-2xl border border-rose-100 transform rotate-1 hover:rotate-0 transition-transform duration-300">
                    <div class="w-28 h-6 bg-gradient-to-r from-rose-300 to-amber-300 mx-auto -mt-7 mb-3 rounded-sm transform -rotate-2 shadow-sm"></div>
                    <div class="aspect-[4/3] rounded-2xl bg-gradient-to-br from-amber-50 via-rose-50 to-indigo-50 flex flex-col items-center justify-center p-6 text-center relative overflow-hidden border border-rose-100">
                        <span class="text-6xl mb-3">👩‍🏫💐</span>
                        <p class="font-handwriting text-2xl text-rose-700 font-bold">"Tri ân Thầy Cô - AIC Dam Ha"</p>
                        <span class="mt-2 px-3 py-1 bg-white/90 rounded-full text-xs font-semibold text-rose-800 shadow-sm">20 / 11 / 2026</span>
                        <span class="absolute top-3 right-3 text-3xl transform rotate-12">🌻</span>
                        <span class="absolute bottom-3 left-3 text-3xl transform -rotate-12">💖</span>
                    </div>
                    <div class="mt-4 flex items-center justify-between px-2">
                        <span class="font-handwriting text-xl text-slate-600">#AICDamHa #TriAn2011</span>
                        <span class="text-xs font-bold text-rose-500">● LIVE STUDIO</span>
                    </div>
                </div>
            </div>
        </main>

        <!-- Footer -->
        <footer class="w-full py-4 text-center text-xs text-slate-600 border-t border-rose-200/50 bg-white/40 backdrop-blur">
            Products by <strong>Luu Trong with AIC</strong> • Trường THPT Đầm Hà • Mừng ngày Nhà giáo Việt Nam 20/11
        </footer>
    </section>


    <!-- ===================================================================== -->
    <!-- PHẦN 2: GIAO DIỆN PHOTOBOOK STUDIO (POPUP FULL-SCREEN)               -->
    <!-- ===================================================================== -->
    <section id="studio-section" class="app-modal app-modal-closed fixed inset-0 z-40 bg-gradient-to-br from-rose-50 via-amber-50 to-slate-100 overflow-y-auto flex-col">
        <div class="max-w-6xl w-full mx-auto px-3 sm:px-6 py-3 sm:py-4 flex-1 flex flex-col">
            <!-- Thanh điều hướng App Bar -->
            <div class="flex items-center justify-between bg-white/90 backdrop-blur px-4 py-3 rounded-2xl shadow-sm border border-rose-100 mb-5">
                <button onclick="backToIntro()" class="flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-slate-100 hover:bg-rose-100 text-slate-700 hover:text-rose-600 text-xs sm:text-sm font-bold transition-colors cursor-pointer shrink-0">
                    <span>✕</span>
                    <span>Đóng App</span>
                </button>
                <h2 class="font-extrabold text-xs sm:text-base text-slate-800 flex items-center gap-1.5 text-center px-2">
                    <span>📷</span>
                    <span>Photobook Studio 20/11</span>
                </h2>
                <label class="flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-gradient-to-r from-amber-100 to-rose-100 hover:opacity-90 text-amber-900 text-xs sm:text-sm font-bold cursor-pointer transition-colors shadow-sm shrink-0">
                    <span>📁</span>
                    <span>Chọn ảnh</span>
                    <input type="file" id="upload-input" accept="image/*" class="hidden" onchange="handleImageUpload(event)">
                </label>
            </div>

            <!-- Khu vực làm việc chính -->
            <div class="flex-1 grid grid-cols-1 lg:grid-cols-12 gap-5 items-start pb-6">
                
                <!-- CỘT TRÁI (7 phần): KHUNG PREVIEW CAMERA / PHOTOBOOK -->
                <div class="lg:col-span-7 flex flex-col items-center w-full px-1">
                    <div id="polaroid-frame" class="relative w-full max-w-lg bg-white text-slate-800 p-4 sm:p-5 pb-7 rounded-3xl shadow-xl border-2 border-rose-100 transition-colors duration-200">
                        
                        <!-- Sticker trang trí viền dễ thương (đã căn chỉnh gọn gàng, không chồng lấn) -->
                        <div class="absolute -top-3 left-4 bg-white text-slate-800 px-2.5 py-0.5 rounded-full shadow-md border border-rose-200 text-xs sm:text-sm font-semibold transform -rotate-6 select-none z-10">🌻 20/11</div>
                        <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-white text-slate-800 px-2.5 py-0.5 rounded-full shadow-md border border-rose-200 text-xs sm:text-sm font-semibold transform rotate-2 select-none z-10">💖 Tri ân</div>
                        <div class="absolute -top-3 right-4 bg-white text-slate-800 px-2.5 py-0.5 rounded-full shadow-md border border-rose-200 text-xs sm:text-sm font-semibold transform rotate-6 select-none z-10">🎓 Thầy cô</div>
                        
                        <div class="absolute top-1/3 -left-2.5 bg-white text-slate-800 px-2 py-0.5 rounded-xl shadow-md border border-rose-200 text-[11px] sm:text-xs font-bold transform -rotate-6 select-none z-10">⭐ AIC</div>
                        <div class="absolute top-2/3 -right-2.5 bg-white text-slate-800 px-2 py-0.5 rounded-xl shadow-md border border-rose-200 text-[11px] sm:text-xs font-bold transform rotate-6 select-none z-10">🌷 Đầm Hà</div>

                        <div class="absolute -bottom-3 left-4 bg-white text-slate-800 px-2.5 py-0.5 rounded-full shadow-md border border-rose-200 text-xs sm:text-sm font-semibold transform rotate-3 select-none z-10">🌸 Thanh xuân</div>
                        <div class="absolute -bottom-3 right-4 bg-white text-slate-800 px-2.5 py-0.5 rounded-full shadow-md border border-rose-200 text-xs sm:text-sm font-semibold transform -rotate-3 select-none z-10">🍎 Tri thức</div>

                        <!-- Vùng hiển thị chính (Tỷ lệ 4:3) -->
                        <div id="viewport-container" class="relative w-full aspect-[4/3] bg-slate-900 rounded-2xl overflow-hidden shadow-inner flex items-center justify-center">
                            <video id="camera-video" autoplay playsinline muted class="w-full h-full object-cover transition-all duration-200"></video>
                            <canvas id="editor-canvas" class="hidden w-full h-full object-contain touch-none cursor-move"></canvas>

                            <div id="camera-error" class="hidden absolute inset-0 bg-slate-800 text-white p-6 flex flex-col items-center justify-center text-center">
                                <span class="text-4xl mb-2">🚫📷</span>
                                <p class="font-bold text-base mb-1">Không thể truy cập Camera</p>
                                <p class="text-xs text-slate-300 mb-4">Vui lòng cấp quyền Camera trên trình duyệt hoặc dùng nút "Chọn ảnh" ở góc trên!</p>
                                <button onclick="startCamera()" class="px-4 py-2 rounded-xl bg-rose-500 text-white text-xs font-bold cursor-pointer">Thử mở lại Camera</button>
                            </div>

                            <div id="countdown-overlay" class="hidden absolute inset-0 bg-black/50 flex items-center justify-center z-20">
                                <span id="countdown-number" class="text-8xl font-extrabold text-white drop-shadow-lg countdown-pulse">3</span>
                            </div>

                            <div id="flash-overlay" class="hidden absolute inset-0 bg-white z-30 pointer-events-none"></div>

                            <div id="mode-badge" class="absolute top-3 left-3 px-2.5 py-1 rounded-full bg-black/60 text-white text-xs font-semibold flex items-center gap-1.5 z-10">
                                <span class="w-2 h-2 rounded-full bg-rose-500 animate-ping"></span>
                                <span>LIVE PREVIEW</span>
                            </div>
                        </div>

                        <!-- Dòng chú thích dưới khung Polaroid -->
                        <div class="mt-3 px-2 flex items-center justify-between gap-2">
                            <input id="caption-input" type="text" value="Cảm ơn Thầy Cô đã chắp cánh ước mơ! 🌻" maxlength="50"
                                class="font-handwriting text-xl sm:text-2xl bg-transparent border-b border-dashed border-current/30 focus:border-rose-500 focus:outline-none w-full py-0.5"
                                placeholder="Nhập lời chúc tri ân...">
                            <span id="frame-tag" class="text-xs font-bold text-rose-600 whitespace-nowrap">20/11</span>
                        </div>
                    </div>

                    <!-- Thanh điều khiển Camera -->
                    <div id="camera-controls" class="w-full max-w-lg mt-5 bg-white/90 backdrop-blur p-3.5 rounded-2xl shadow-md border border-rose-100 flex items-center justify-between gap-2">
                        <button onclick="cycleTimer()" id="timer-btn" class="flex-1 py-2.5 px-3 rounded-xl bg-slate-100 hover:bg-rose-50 text-slate-700 font-semibold text-xs sm:text-sm flex items-center justify-center gap-1.5 transition-colors cursor-pointer">
                            <span>⏱️</span>
                            <span id="timer-label">Hẹn giờ: Tắt</span>
                        </button>
                        <button onclick="triggerCapture()" class="w-16 h-16 rounded-full bg-gradient-to-tr from-indigo-600 via-rose-500 to-amber-500 p-1 shadow-lg shadow-rose-500/30 hover:scale-105 active:scale-95 transition-transform flex items-center justify-center cursor-pointer shrink-0">
                            <div class="w-full h-full rounded-full border-2 border-white flex items-center justify-center text-white text-2xl">
                                📸
                            </div>
                        </button>
                        <button onclick="switchCamera()" class="flex-1 py-2.5 px-3 rounded-xl bg-slate-100 hover:bg-rose-50 text-slate-700 font-semibold text-xs sm:text-sm flex items-center justify-center gap-1.5 transition-colors cursor-pointer">
                            <span>🔄</span>
                            <span>Đảo Cam</span>
                        </button>
                    </div>

                    <!-- Thanh điều khiển Sau Khi Chụp -->
                    <div id="editor-controls" class="hidden w-full max-w-lg mt-5 bg-white/90 backdrop-blur p-3.5 rounded-2xl shadow-md border border-rose-100 flex items-center justify-between gap-3">
                        <button onclick="retakePhoto()" class="flex-1 py-3 px-4 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-sm flex items-center justify-center gap-1.5 transition-colors cursor-pointer">
                            <span>↩️</span>
                            <span>Chụp lại</span>
                        </button>
                        <button onclick="downloadPhotobook()" class="flex-[2] py-3 px-5 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-600 hover:to-teal-700 text-white font-bold text-sm shadow-md shadow-emerald-500/20 flex items-center justify-center gap-2 transition-all cursor-pointer">
                            <span>⬇️</span>
                            <span>Lưu ảnh Photobook về máy</span>
                        </button>
                    </div>
                </div>

                <!-- CỘT PHẢI (5 phần): BẢNG CHỌN MÀU, KHUNG & STICKER -->
                <div class="lg:col-span-5 w-full space-y-4">
                    
                    <!-- 1. Bảng chọn Khung hình -->
                    <div class="bg-white/90 backdrop-blur p-4 rounded-2xl shadow-sm border border-rose-100">
                        <h3 class="font-bold text-sm text-slate-800 flex items-center gap-1.5 mb-3">
                            <span>🖼️</span>
                            <span>Chọn kiểu khung Photobook</span>
                        </h3>
                        <div class="grid grid-cols-4 gap-2">
                            <button onclick="setFrameStyle('classic', this)" class="frame-btn ring-2 ring-rose-500 bg-rose-50 p-2 rounded-xl border border-slate-200 text-center cursor-pointer transition-all">
                                <div class="w-6 h-6 rounded-md mx-auto mb-1 bg-white border border-slate-300"></div>
                                <span class="text-[11
